<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark variant. Compose theme will be dark too; this controls status/nav bars. -->
    <style name="Theme.GreenStep" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
